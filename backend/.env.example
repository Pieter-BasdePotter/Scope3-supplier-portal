# Supplier token expiry
TOKEN_EXPIRY_HOURS=72

# Server
PORT=3001
NODE_ENV=development

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Frontend URL (for CORS)
