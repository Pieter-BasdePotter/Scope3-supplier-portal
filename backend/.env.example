# Database
DATABASE_URL="mysql://root:password@localhost:3306/scope3_portal"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Supplier token expiry
TOKEN_EXPIRY_HOURS=72

# Server
PORT=3001
NODE_ENV=development

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
