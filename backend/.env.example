# Database
DATABASE_URL="mysql://root:password@localhost:3306/scope3_Massure_test"
# MySQL — update DB_PASSWORD if your MySQL root has a password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scope3_Massure_test
DB_USER=root
DB_PASSWORD=Angela123!

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
